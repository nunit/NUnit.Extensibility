<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NUnit.Extensibility</RootNamespace>
    <TargetFrameworks>net462;netstandard2.0</TargetFrameworks>
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>NUnit.Extensibility</PackageId>
    <Title>NUnit Extensibility</Title>
    <Description>Contains implementation of the NUnit extensibility model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\..\nunit_256.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit.Engine.Api" />
    <PackageReference Include="NUnit.Common" />
    <PackageReference Include="TestCentric.Metadata" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\nunit.extensibility.api\nunit.extensibility.api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="nunit.extensibility.tests, PublicKey=$(NUnitPublicKey)" />
  </ItemGroup>

</Project>
